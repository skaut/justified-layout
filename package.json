{
  "name": "@skaut/justified-layout",
  "version": "4.1.0",
  "description": "Pass in box sizes and get back sizes and coordinates for a justified layout",
  "keywords": [
    "justify",
    "grid",
    "photos",
    "layout",
    "boxes"
  ],
  "homepage": "https://github.com/skaut/justified-layout#readme",
  "bugs": {
    "url": "https://github.com/skaut/justified-layout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaut/justified-layout.git"
  },
  "license": "MIT",
  "author": "Marek Dědič <developer@dedic.eu>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/justified-layout.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/justified-layout.cjs",
  "module": "./lib/index.js",
  "types": "./types/index.d.cts",
  "files": [
    "demo.html",
    "dist",
    "lib",
    "types"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint . && attw --pack .",
    "prepack": "npm run build",
    "test": "c8 mocha"
  },
  "c8": {
    "include": [
      "lib/**/*.js"
    ],
    "reporter": [
      "text",
      "lcovonly"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-config-flickr": "^3.0.0",
    "eslint-plugin-package-json": "^1.7.1",
    "expect": "30.4.1",
    "globals": "^17.11.0",
    "mocha": "^11.0.1",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
